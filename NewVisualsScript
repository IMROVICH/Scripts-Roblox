-- Плавное появление/исчезновение кнопок категорий
local function animateCategoryButtons(appearing)
	for i, btnInfo in ipairs(categoryButtons) do
		if appearing then
			-- Начальное состояние: полностью прозрачные
			btnInfo.frame.BackgroundTransparency = 1
			btnInfo.label.TextTransparency = 1
			btnInfo.stroke.Transparency = 1
			-- Staggered fade-in (кастомный порядок: Атмосфера, Визуал, Геймплей, Экран)
			local fadeDelays = {0.38,0.38,0.38,0.38,0.38,0.38,0.38,0.38,0.38,0.38,0.38,0.38}
			task.delay(fadeDelays[i] or 0, function()
				TweenService:Create(btnInfo.frame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					BackgroundTransparency = 0
				}):Play()
				TweenService:Create(btnInfo.label, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					TextTransparency = 0
				}):Play()
				TweenService:Create(btnInfo.stroke, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					Transparency = 0.3
				}):Play()
			end)
		else
			-- Одновременное исчезновение всех кнопок
			TweenService:Create(btnInfo.frame, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				BackgroundTransparency = 1
			}):Play()
			TweenService:Create(btnInfo.label, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				TextTransparency = 1
			}):Play()
			TweenService:Create(btnInfo.stroke, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				Transparency = 1
			}):Play()
		end
	end
end

-- Анимация открытия/закрытия
local function toggleMenu()
	menuOpen = not menuOpen
	
	if menuOpen then
		-- Включаем элементы
		menuFrame.Visible = true
		menuBlur.Enabled = true
		
		-- Начальное состояние меню (сжатое, прозрачное, чуть ниже)
		menuFrame.Size = UDim2.fromOffset(MENU_WIDTH, 0)
		menuFrame.BackgroundTransparency = 1
		menuFrame.Position = UDim2.new(0.5, 0, 0.5, -20)
		menuStroke.Transparency = 1
		
		-- Начальное состояние панели категорий (скрыта)
		categoryBar.Visible = false
		
		-- Затемнение фона (плавно, 0.4s)
		TweenService:Create(darkOverlay, TweenInfo.new(ANIM_TIME_SLOW, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			BackgroundTransparency = 0.5
		}):Play()
		
		-- Размытие фона (плавно, 0.4s)
		TweenService:Create(menuBlur, TweenInfo.new(ANIM_TIME_SLOW, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = 12
		}):Play()
		
		-- Появление меню: рост высоты + сдвиг вверх + проявление (0.35s, Quint Out)
		TweenService:Create(menuFrame, TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(MENU_WIDTH, MENU_HEIGHT),
			BackgroundTransparency = 0.05,
			Position = UDim2.new(0.5, 0, 0.5, -35)
		}):Play()
		TweenService:Create(menuStroke, TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Transparency = 0
		}):Play()
		
		-- Появление панели категорий с задержкой (fade-in + лёгкое увеличение, без движения снизу)
		task.delay(0.12, function()
			categoryBar.Visible = true
			categoryBar.Size = UDim2.fromOffset(MENU_WIDTH - 40, 50)
			categoryBar.BackgroundTransparency = 1
			catBarStroke.Transparency = 1
			
			TweenService:Create(categoryBar, TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Size = UDim2.fromOffset(MENU_WIDTH, 50),
				BackgroundTransparency = 0.05
			}):Play()
			TweenService:Create(catBarStroke, TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Transparency = 0
			}):Play()
			-- Плавное появление кнопок по очереди
			animateCategoryButtons(true)
		end)
	else
		-- Плавное исчезновение кнопок
		animateCategoryButtons(false)
		
		-- Скрытие панели категорий (fade-out + лёгкое уменьшение, 0.25s)
		TweenService:Create(categoryBar, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Size = UDim2.fromOffset(MENU_WIDTH - 40, 50),
			BackgroundTransparency = 1
		}):Play()
		TweenService:Create(catBarStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Transparency = 1
		}):Play()
		
		-- Скрытие меню: сжатие + сдвиг вниз + исчезновение (0.35s, Quint In)
		local closeTween = TweenService:Create(menuFrame, TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Size = UDim2.fromOffset(MENU_WIDTH, 0),
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, 0, 0.5, -20)
		})
		TweenService:Create(menuStroke, TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Transparency = 1
		}):Play()
		
		-- Убираем затемнение и размытие
		TweenService:Create(darkOverlay, TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			BackgroundTransparency = 1
		}):Play()
		
		TweenService:Create(menuBlur, TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Size = 0
		}):Play()
		
		closeTween.Completed:Connect(function()
			if not menuOpen then
				menuFrame.Visible = false
				categoryBar.Visible = false
				menuBlur.Enabled = false
			end
		end)
		closeTween:Play()
	end
end

-- Обработка нажатий клавиш
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == TOGGLE_KEY then
		toggleMenu()
	end
end)


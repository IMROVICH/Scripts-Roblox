-- Функция создания тоггла
local function createToggle(parent, effectData)
	local toggleFrame = Instance.new("Frame")
	toggleFrame.Name = "Toggle"
	toggleFrame.Size = UDim2.fromOffset(46, 24)
	toggleFrame.Position = UDim2.new(1, -56, 0.5, -12)
	toggleFrame.BackgroundColor3 = effectData.enabled and COLOR_TOGGLE_ON or COLOR_TOGGLE_OFF
	toggleFrame.ZIndex = 3
	toggleFrame.Parent = parent
	
	local toggleCorner = Instance.new("UICorner")
	toggleCorner.CornerRadius = UDim.new(1, 0)
	toggleCorner.Parent = toggleFrame
	
	local toggleKnob = Instance.new("Frame")
	toggleKnob.Name = "Knob"
	toggleKnob.Size = UDim2.fromOffset(18, 18)
	toggleKnob.Position = effectData.enabled and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
	toggleKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	toggleKnob.ZIndex = 4
	toggleKnob.Parent = toggleFrame
	
	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = toggleKnob
	
	return toggleFrame, toggleKnob
end

-- Функция создания карточки эффекта
local function createEffectItem(effectData)
	local item = Instance.new("Frame")
	item.Name = effectData.name
	item.Size = UDim2.new(1, 0, 0, 56)
	item.BackgroundColor3 = COLOR_BG_ITEM
	item.ZIndex = 3
	item.Parent = effectsContainer
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = item
	
	local stroke = Instance.new("UIStroke")
	stroke.Color = COLOR_STROKE
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = item
	
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -70, 1, 0)
	nameLabel.Position = UDim2.fromOffset(15, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = effectData.name
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.TextSize = 17
	nameLabel.TextColor3 = COLOR_TEXT
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.ZIndex = 4
	nameLabel.Parent = item
	
	local toggleBg, knob = createToggle(item, effectData)
	
	local function updateToggle()
		TweenService:Create(toggleBg, TweenInfo.new(ANIM_TIME), {
			BackgroundColor3 = effectData.enabled and COLOR_TOGGLE_ON or COLOR_TOGGLE_OFF
		}):Play()
		TweenService:Create(knob, TweenInfo.new(ANIM_TIME), {
			Position = effectData.enabled and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
		}):Play()
	end
	
	-- Клик по карточке = переключение
	local button = Instance.new("TextButton")
	button.Size = UDim2.fromScale(1, 1)
	button.BackgroundTransparency = 1
	button.Text = ""
	button.ZIndex = 5
	button.Parent = item
	
	button.MouseButton1Click:Connect(function()
		effectData.enabled = not effectData.enabled
		updateToggle()
		if effectData.apply then
			effectData.apply(effectData.enabled)
		end
	end)
	
	-- Hover
	button.MouseEnter:Connect(function()
		TweenService:Create(item, TweenInfo.new(ANIM_TIME), {
			BackgroundColor3 = COLOR_BG_ITEM_HOVER
		}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(item, TweenInfo.new(ANIM_TIME), {
			BackgroundColor3 = COLOR_BG_ITEM
		}):Play()
	end)
	
	effectData._updateToggle = updateToggle
	return item
end

-- Отрисовка эффектов для категории
local function showCategory(catIndex)
	-- Очищаем старые элементы
	for _, child in ipairs(effectsContainer:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	
	currentCategory = catIndex
	local cat = categories[catIndex]
	
	-- Обновляем кнопки категорий
	for i, btnInfo in ipairs(categoryButtons) do
		TweenService:Create(btnInfo.frame, TweenInfo.new(ANIM_TIME), {
			BackgroundColor3 = (i == catIndex) and COLOR_CATEGORY_ACTIVE or COLOR_CATEGORY_INACTIVE
		}):Play()
		TweenService:Create(btnInfo.label, TweenInfo.new(ANIM_TIME), {
			TextColor3 = (i == catIndex) and COLOR_TEXT or COLOR_TEXT_DIM
		}):Play()
	end
	
	-- Создаём элементы
	for _, effect in ipairs(cat.effects) do
		createEffectItem(effect)
	end
end

